# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# For local dev or docker-compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cpe_bot

# uHunt / UVa API Settings
UHUNT_BASE_URL=https://uhunt.onlinejudge.org/api
UHUNT_TIMEOUT_SECONDS=10

# Polling & Session Settings
# Polling interval in seconds for tracking active sessions (default: 20s)
SUBMISSION_POLL_INTERVAL=20

# Daily Problem Settings
# Prevent the same problem from repeating within N days (default: 30)
DAILY_REPEAT_COOLDOWN_DAYS=30

# Thread Management
# Whether to automatically archive the thread once problem is solved (true/false)
AUTO_ARCHIVE_THREAD=false

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
