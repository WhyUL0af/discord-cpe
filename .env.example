# discord-cpe：Ubuntu Docker Compose 通知模式
# 每日一題 / 7 題模擬考 → 使用者到 UVa 提交 → uHunt 追蹤與排行榜
# 預設只啟動 PostgreSQL 與 Discord Bot，不需要網域、Discord OAuth 或 Judge0。
# 首次設定時將此範本複製至 /etc/discord-cpe/.env，再填入秘密。
# 已有 .env 請手動更新，不要直接覆蓋既有設定；不要將 .env 提交 Git。
#
# 必須在含 docker-compose.yml 的專案目錄執行：
# sudo docker compose --env-file /etc/discord-cpe/.env up -d --build postgres discord-bot
# --env-file 不會指定 Compose 設定檔，也不會切換工作目錄。
# deploy.sh 每次建立 /opt/discord-cpe/releases/<版本>，成功後更新 current。
# 專案入口為 /opt/discord-cpe/current，備份位於 /srv/discord-cpe/backups。

# ── 必填：Discord Bot ──
# Discord Developer Portal → Application → Bot → Token（不是 OAuth Client Secret）。
DISCORD_TOKEN=your_discord_bot_token_here

# ── 必填：PostgreSQL ──
# 改成長隨機英數字密碼；目前 Compose 直接將密碼放進連線 URL，避免 URL 保留字元。
# 已有 PostgreSQL volume 時，此值須與資料庫現有密碼一致；改 .env 不會重設既有密碼。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password

# postgres 是本專案 Compose service 的內部 hostname，不是 Ubuntu 的 localhost。
# ${POSTGRES_PASSWORD} 引用上方密碼；Compose 也會覆寫容器中的 DATABASE_URL。
# 若不用 Compose 的 PostgreSQL，需自行指定實際資料庫連線，並調整 Compose 覆寫設定。
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/cpe_bot

# ── UVa / uHunt：通常沿用預設即可，無需 API Key ──
UHUNT_BASE_URL=https://uhunt.onlinejudge.org/api
UHUNT_TIMEOUT_SECONDS=10

# 輪詢所有已綁定 UVa 使用者的間隔（秒），不需建立單題 session。
SUBMISSION_POLL_INTERVAL=20

# 每日一題避免重複的天數。
DAILY_REPEAT_COOLDOWN_DAYS=30

# ── 執行環境 ──
APP_ENV=production
JUDGE_PROVIDER=disabled
LOG_LEVEL=INFO

# ── 以下為保留的舊網站設定；通知模式不需要，維持註解即可 ──
# 啟用 website Compose profile 前，另外設定公開 HTTPS 網址、session secret 與 OAuth。
# Redirect URI 必須與 Discord Developer Portal 的 OAuth2 Redirects 完全一致。
# WEBSITE_BASE_URL=https://cpe.yuloaf.work
# WEBSITE_SESSION_SECRET=replace_with_a_long_random_session_secret
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=https://cpe.yuloaf.work/auth/callback

# 僅供舊網站的 Judge0 integration；秘密只放後端，不得傳給 frontend。
# JUDGE_PROVIDER=judge0
# JUDGE0_URL=
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
# JUDGE0_TIMEOUT_SECONDS=15
# JUDGE0_DEFAULT_MEMORY_LIMIT_KB=262144

# 舊網站 Mock 模式僅可用於獨立 development database。
# APP_ENV=development
# JUDGE_PROVIDER=mock
# JUDGE_MOCK_VERDICT=ACCEPTED
# JUDGE_MOCK_DELAY_SECONDS=0.3

# 保留的舊 Thread 選項，通知模式不使用。
# AUTO_ARCHIVE_THREAD=false
