[Unit]
Description=CPE Discord notification bot (Docker Compose)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/discord-cpe/current
ExecStart=/usr/bin/docker compose --project-name cpe-bot --env-file /etc/discord-cpe/.env -f /opt/discord-cpe/current/docker-compose.yml up -d postgres discord-bot
ExecStop=/usr/bin/docker compose --project-name cpe-bot --env-file /etc/discord-cpe/.env -f /opt/discord-cpe/current/docker-compose.yml stop discord-bot postgres
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
